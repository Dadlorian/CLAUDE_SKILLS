{
  "logical_switch": {
    "display_name": "Production-Tenant-A",
    "admin_state": "UP",
    "replication_mode": "MTEP",
    "transport_zone_id": "tz-overlay-001",
    "vni": 5000,
    "address_family": "IPV4"
  },
  "logical_router": {
    "display_name": "Tier-1-Tenant-A",
    "router_type": "TIER1",
    "tier0_path": "/infra/tier-0s/Tier-0-GW",
    "route_advertisement_types": ["TIER1_CONNECTED", "TIER1_LB_VIP"],
    "interfaces": [
      {
        "display_name": "downlink-prod-net",
        "logical_switch_id": "5000",
        "subnet_ip": "10.100.0.1/24",
        "access_vlan_id": 100
      }
    ]
  },
  "security_policy": {
    "display_name": "Production-Isolation",
    "rules": [
      {
        "display_name": "Allow-Web-to-App",
        "action": "ALLOW",
        "source_groups": ["/infra/domains/cgw/groups/web-tier"],
        "destination_groups": ["/infra/domains/cgw/groups/app-tier"],
        "services": ["HTTPS"]
      },
      {
        "display_name": "Allow-App-to-DB",
        "action": "ALLOW",
        "source_groups": ["/infra/domains/cgw/groups/app-tier"],
        "destination_groups": ["/infra/domains/cgw/groups/db-tier"],
        "services": ["MySQL"]
      }
    ]
  },
  "load_balancer": {
    "display_name": "LB-Web-Services",
    "size": "MEDIUM",
    "virtual_servers": [
      {
        "display_name": "VS-HTTPS",
        "ip_address": "10.100.0.100",
        "ports": [443],
        "protocol": "HTTPS",
        "pool_id": "pool-web-servers"
      }
    ],
    "pools": [
      {
        "display_name": "pool-web-servers",
        "algorithm": "LEAST_CONN",
        "active_monitor_ids": ["HTTP-Monitor"],
        "members": [
          {"ip_address": "10.100.0.10"},
          {"ip_address": "10.100.0.11"}
        ]
      }
    ]
  }
}
