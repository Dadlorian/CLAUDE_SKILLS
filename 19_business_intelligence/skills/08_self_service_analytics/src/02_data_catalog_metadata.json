        "workaround": "Filter WHERE signup_date IS NOT NULL for time-based analysis",
        "tracking_ticket": "DATA-1234"
      }
    ],
    
    "example_queries": [
      {
        "name": "Active Enterprise Customers",
        "description": "Find all active enterprise customers",
        "sql": "SELECT customer_id, email, signup_date, lifetime_value\nFROM dim_customers\nWHERE current_plan = 'enterprise'\n  AND account_status = 'active'\nORDER BY lifetime_value DESC;"
      },
      {
        "name": "Signups by Month",
        "description": "Count of new signups per month",
        "sql": "SELECT\n  DATE_TRUNC('month', signup_date) as month,\n  COUNT(*) as new_signups\nFROM dim_customers\nWHERE signup_date >= '2024-01-01'\nGROUP BY 1\nORDER BY 1;"
      }
    ],
    
