              }
            ]
          }
        ]
      },
      {
        "name": "Product",
        "columns": [
          {
            "name": "ProductKey",
            "dataType": "int64",
            "isHidden": true,
            "isKey": true,
            "sourceColumn": "ProductKey"
          },
          {
            "name": "ProductName",
            "dataType": "string",
            "sourceColumn": "ProductName"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category"
          },
          {
            "name": "Subcategory",
            "dataType": "string",
            "sourceColumn": "Subcategory"
          },
          {
            "name": "Brand",
            "dataType": "string",
            "sourceColumn": "Brand"
          }
        ],
        "partitions": [
          {
            "name": "Product",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SqlServer localhost SalesDW\",",
                "    dbo_DimProduct = Source{[Schema=\"dbo\",Item=\"DimProduct\"]}[Data],",
                "    FilteredRows = Table.SelectRows(dbo_DimProduct, each [IsCurrent] = true)",
                "in",
                "    FilteredRows"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Product Hierarchy",
            "levels": [
              {
                "name": "Category",
                "ordinal": 0,
                "column": "Category"
              },
              {
                "name": "Subcategory",
                "ordinal": 1,
                "column": "Subcategory"
              },
              {
                "name": "Product",
                "ordinal": 2,
                "column": "ProductName"
              }
            ]
          }
        ]
      },
      {
        "name": "Sales",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "DateKey"
          },
          {
            "name": "ProductKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ProductKey"
          },
          {
            "name": "SalesAmount",
            "dataType": "decimal",
            "sourceColumn": "SalesAmount",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "summarizeBy": "sum"
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "Cost",
            "dataType": "decimal",
            "sourceColumn": "Cost",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SqlServer localhost SalesDW\",",
                "    dbo_FactSales = Source{[Schema=\"dbo\",Item=\"FactSales\"]}[Data]",
                "in",
                "    dbo_FactSales"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales Amount",
            "expression": "SUM(Sales[SalesAmount])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Total Cost",
            "expression": "SUM(Sales[Cost])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Profit",
            "expression": "[Sales Amount] - [Total Cost]",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Profit Margin %",
            "expression": "DIVIDE([Profit], [Sales Amount], 0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD([Sales Amount], 'Date'[Date])",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Sales LY",
            "expression": "CALCULATE([Sales Amount], SAMEPERIODLASTYEAR('Date'[Date]))",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "YoY Growth %",
            "expression": [
              "VAR CurrentPeriod = [Sales Amount]",
              "VAR PriorPeriod = [Sales LY]",
              "RETURN",
              "DIVIDE(CurrentPeriod - PriorPeriod, PriorPeriod, 0)"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "Sales-Date",
        "fromTable": "Sales",
        "fromColumn": "DateKey",
        "toTable": "Date",
        "toColumn": "DateKey",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "Sales-Product",
        "fromTable": "Sales",
        "fromColumn": "ProductKey",
        "toTable": "Product",
        "toColumn": "ProductKey",
        "crossFilteringBehavior": "oneDirection"
      }
    ],
    "roles": [
      {
        "name": "Sales Managers",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "Sales",
            "filterExpression": "'Date'[Year] >= YEAR(TODAY()) - 2"
          }
        ]
      }
    ]
  }
}
