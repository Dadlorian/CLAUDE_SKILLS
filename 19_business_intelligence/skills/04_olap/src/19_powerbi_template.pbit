{
  "version": "4.0",
  "dataModel": {
    "name": "Sales Analytics Template",
    "tables": [
      {
        "name": "Date",
        "isHidden": false,
        "columns": [
          {"name": "Date", "dataType": "DateTime", "isKey": true},
          {"name": "Year", "dataType": "Int64"},
          {"name": "Month", "dataType": "Int64"}
        ],
        "measures": []
      },
      {
        "name": "Sales",
        "columns": [
          {"name": "SalesAmount", "dataType": "Decimal"},
          {"name": "Quantity", "dataType": "Int64"}
        ],
        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(Sales[SalesAmount])",
            "formatString": "$#,0"
          },
          {
            "name": "Sales YTD",
            "expression": "TOTALYTD([Total Sales], 'Date'[Date])",
            "formatString": "$#,0"
          }
        ]
      }
    ]
  }
}
