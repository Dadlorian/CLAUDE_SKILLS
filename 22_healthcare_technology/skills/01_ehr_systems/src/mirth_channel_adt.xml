      <elements>
        <!-- Filter: Only process A01, A03, A08 messages -->
        <com.mirth.connect.plugins.rulebuilder.RuleBuilderRule version="3.12.0">
          <name>Accept Only ADT A01, A03, A08</name>
          <sequenceNumber>0</sequenceNumber>
