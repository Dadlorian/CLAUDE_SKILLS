        <driver>org.postgresql.Driver</driver>
        <url>jdbc:postgresql://localhost:5432/ehr_database</url>
        <username>mirth_user</username>
        <password>encrypted_password_here</password>
        <query>
          -- Insert or update patient
          INSERT INTO patient (
            medical_record_number,
            first_name,
            middle_name,
            last_name,
            date_of_birth,
            gender_code,
            created_timestamp
          ) VALUES (
            '${msg['PID']['PID.3']['PID.3.1']}',
            '${msg['PID']['PID.5']['PID.5.2']}',
            '${msg['PID']['PID.5']['PID.5.3']}',
            '${msg['PID']['PID.5']['PID.5.1']}',
            '${msg['PID']['PID.7']}',
            '${msg['PID']['PID.8']}',
            CURRENT_TIMESTAMP
          )
          ON CONFLICT (medical_record_number)
          DO UPDATE SET
            first_name = EXCLUDED.first_name,
            last_name = EXCLUDED.last_name,
            modified_timestamp = CURRENT_TIMESTAMP;
        </query>
      </properties>
      <transformer version="3.12.0">
        <elements>
          <!-- Transformation: Validate and format data -->
          <com.mirth.connect.plugins.mapper.MapperStep version="3.12.0">
            <name>Validate MRN</name>
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <variable>mrn</variable>
            <mapping>msg['PID']['PID.3']['PID.3.1'].toString()</mapping>
            <defaultValue/>
            <replacements/>
            <scope>CHANNEL</scope>
          </com.mirth.connect.plugins.mapper.MapperStep>

          <com.mirth.connect.plugins.javascriptstep.JavaScriptStep version="3.12.0">
            <name>Validate Required Fields</name>
            <sequenceNumber>1</sequenceNumber>
            <enabled>true</enabled>
            <script><![CDATA[
              // Validate MRN exists
              if (!$('mrn') || $('mrn').length === 0) {
                throw new Error('Missing required field: MRN');
              }

              // Validate patient name
              var lastName = msg['PID']['PID.5']['PID.5.1'].toString();
              var firstName = msg['PID']['PID.5']['PID.5.2'].toString();

              if (!lastName || !firstName) {
                throw new Error('Missing required field: Patient name');
              }

              // Log successful validation
              logger.info('Message validated successfully for MRN: ' + $('mrn'));
            ]]></script>
          </com.mirth.connect.plugins.javascriptstep.JavaScriptStep>
        </elements>
