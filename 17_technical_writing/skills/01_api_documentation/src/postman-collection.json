{
  "info": {
    "name": "Production API Collection",
    "description": "Complete Postman collection for API documentation examples. Includes authentication, CRUD operations, webhooks, and rate limiting.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.example.com/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "your-client-id",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "your-client-secret",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "your-webhook-secret",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "OAuth2 - Get Authorization Code",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://auth.example.com/oauth/authorize?client_id={{client_id}}&redirect_uri=http://localhost:3000/callback&response_type=code&scope=openid%20profile%20email&state=random_state_123",
              "protocol": "https",
              "host": ["auth", "example", "com"],
              "path": ["oauth", "authorize"],
              "query": [
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:3000/callback"
                },
                {
                  "key": "response_type",
                  "value": "code"
                },
                {
                  "key": "scope",
                  "value": "openid profile email"
                },
                {
                  "key": "state",
                  "value": "random_state_123"
                }
              ]
            },
            "description": "Step 1 of OAuth2 flow - Get authorization code"
          }
        },
        {
          "name": "OAuth2 - Exchange Code for Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                },
                {
                  "key": "code",
                  "value": "auth_code_from_previous_step"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                },
                {
                  "key": "redirect_uri",
                  "value": "http://localhost:3000/callback"
                }
              ]
            },
            "url": {
              "raw": "https://auth.example.com/oauth/token",
              "protocol": "https",
              "host": ["auth", "example", "com"],
              "path": ["oauth", "token"]
            },
            "description": "Step 2 of OAuth2 flow - Exchange authorization code for access token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  pm.environment.set('jwt_token', jsonData.access_token);",
                  "  pm.environment.set('refresh_token', jsonData.refresh_token);",
                  "  console.log('Token saved: ' + jsonData.access_token.substring(0, 20) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refresh_token}}"
                },
                {
                  "key": "client_id",
                  "value": "{{client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{client_secret}}"
                }
              ]
            },
            "url": {
              "raw": "https://auth.example.com/oauth/token",
              "protocol": "https",
              "host": ["auth", "example", "com"],
              "path": ["oauth", "token"]
            },
            "description": "Refresh expired access token using refresh token"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=10&sort=created_at",
              "host": ["{{base_url}}"],
              "path": ["users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "created_at"
                }
              ]
            },
            "description": "Retrieve paginated list of users"
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"John\",\"lastName\":\"Doe\",\"email\":\"john.doe@example.com\",\"phone\":\"+1-555-0100\",\"role\":\"user\"}"
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": ["{{base_url}}"],
              "path": ["users"]
            },
            "description": "Create a new user account"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/123",
              "host": ["{{base_url}}"],
              "path": ["users", "123"]
            },
            "description": "Retrieve a specific user by ID"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstName\":\"John\",\"lastName\":\"Smith\",\"phone\":\"+1-555-0200\"}"
            },
            "url": {
              "raw": "{{base_url}}/users/123",
              "host": ["{{base_url}}"],
              "path": ["users", "123"]
            },
            "description": "Update an existing user"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/123",
              "host": ["{{base_url}}"],
              "path": ["users", "123"]
            },
            "description": "Delete a user account"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products?category=electronics&sort=price&order=asc",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                {
                  "key": "category",
                  "value": "electronics"
                },
                {
                  "key": "sort",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "asc"
                }
              ]
            },
            "description": "Get list of products with filtering and sorting"
          }
        },
        {
          "name": "Get Product Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products/456",
              "host": ["{{base_url}}"],
              "path": ["products", "456"]
            },
            "description": "Retrieve detailed information about a product"
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Wireless Headphones\",\"description\":\"High-quality noise-canceling headphones\",\"price\":199.99,\"currency\":\"USD\",\"category\":\"electronics\",\"sku\":\"WH-1000XM4\",\"stock\":50}"
            },
            "url": {
              "raw": "{{base_url}}/products",
              "host": ["{{base_url}}"],
              "path": ["products"]
            },
            "description": "Create a new product"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
