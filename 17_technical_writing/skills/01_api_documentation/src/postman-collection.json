            "body": {
              "mode": "raw",
              "raw": "{\"url\":\"https://your-domain.com/webhooks/events\",\"events\":[\"user.created\",\"order.placed\",\"payment.completed\"],\"description\":\"Production webhook endpoint\"}"
            },
            "url": {
              "raw": "{{base_url}}/webhooks",
