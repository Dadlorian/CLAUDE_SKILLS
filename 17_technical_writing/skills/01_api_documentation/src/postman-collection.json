          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "First request to test rate limiting"
          }
        },
        {
          "name": "Test Rate Limit - Multiple Requests",
          "request": {
