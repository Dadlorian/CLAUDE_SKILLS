          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"123\",\"items\":[{\"productId\":\"456\",\"quantity\":2,\"price\":199.99}],\"shippingAddress\":{\"street\":\"123 Main St\",\"city\":\"San Francisco\",\"state\":\"CA\",\"zip\":\"94105\"},\"paymentMethod\":\"credit_card\"}"
            },
            "url": {
              "raw": "{{base_url}}/orders",
