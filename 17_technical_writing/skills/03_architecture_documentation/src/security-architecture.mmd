%% Security Architecture Diagram
%% Comprehensive security layers: authentication, encryption, authorization, compliance

graph TB
    %% User/Client Layer
    subgraph UserLayer["Users & Clients"]
        WebUser["🌐 Web User<br/>Browser"]
        MobileUser["📱 Mobile User<br/>App"]
        ServiceAccount["🔑 Service Account<br/>API key"]
    end

    %% DDoS & WAF Protection
    subgraph EdgeSecurity["Edge Security - DDoS & WAF"]
        CloudFlare["🛡️ Cloudflare<br/>DDoS mitigation<br/>Rate limiting<br/>Bot detection"]
        WAF["🚨 Web Application Firewall<br/>ModSecurity<br/>OWASP Top 10<br/>SQL injection blocking"]
    end

    %% Authentication Layer
    subgraph AuthLayer["Authentication Layer"]
        AuthGateway["🔐 Auth Gateway<br/>Request inspection<br/>Token validation<br/>Session management"]

        subgraph AuthMethods["Authentication Methods"]
            OAuth2["🔑 OAuth 2.0<br/>Authorization Code flow<br/>Refresh tokens<br/>Token rotation: 1h"]
            SAML["🏢 SAML 2.0<br/>Enterprise SSO<br/>IdP metadata"]
            MFA["✅ Multi-Factor Auth<br/>TOTP/Google Authenticator<br/>SMS backup codes<br/>Hardware keys"]
            LDAP["👥 LDAP/Active Directory<br/>Corporate directory<br/>Password sync"]
        end

        subgraph TokenManagement["Token Management"]
            JWTHandler["🎫 JWT Handler<br/>RS256 signing<br/>Key rotation<br/>aud/iss claims"]
            SessionStore["📦 Session Store<br/>Redis<br/>TTL: 24h<br/>Encrypted"]
        end
    end

    %% Authorization Layer
    subgraph AuthzLayer["Authorization Layer - RBAC/ABAC"]
        PolicyEngine["⚙️ Policy Engine<br/>OPA/Kyverno<br/>Dynamic policies<br/>Attribute-based"]

        subgraph Permissions["Permission Models"]
            RoleMatrix["📊 Role Matrix<br/>Admin<br/>Manager<br/>User<br/>Guest"]
            ResourceACL["🔒 Resource ACL<br/>Per-resource<br/>Per-user"]
            TenantIsolation["🏢 Tenant Isolation<br/>Data segregation<br/>Query filtering"]
        end
    end

    %% Encryption Layer
    subgraph Encryption["Encryption Layer"]
        subgraph TransitEncryption["In-Transit Encryption"]
            TLS["🔐 TLS 1.3<br/>Client→Server<br/>HSTS enabled<br/>Perfect forward secrecy"]
            mTLS["🤝 Mutual TLS<br/>Service-to-service<br/>Certificate validation<br/>Istio integration"]
            VPN["🔒 VPN/Private Link<br/>Database connections<br/>Admin access"]
        end

        subgraph AtRestEncryption["At-Rest Encryption"]
            DBTE["🗄️ DB Encryption<br/>AES-256<br/>Column-level<br/>Transparent encryption"]
            DiskEncryption["💾 Disk Encryption<br/>EBS encryption<br/>LUKS<br/>Key management"]
            FieldEncryption["🔑 Field Encryption<br/>PII columns<br/>Credit cards<br/>SSN masking"]
        end

        subgraph KeyManagement["Key Management"]
            KMS["🔑 Key Management Service<br/>AWS KMS/Vault<br/>Master keys<br/>Key rotation: 90d"]
            SecretVault["🗝️ Secret Vault<br/>HashiCorp Vault<br/>API credentials<br/>Database passwords"]
        end
    end

    %% API Security
    subgraph APISecure["API Security"]
        RateLimiting["⏱️ Rate Limiting<br/>100 req/min user<br/>1000 req/min app<br/>Token bucket"]
        InputValidation["✔️ Input Validation<br/>Schema validation<br/>Type checking<br/>XSS prevention"]
        APIKey["🔑 API Key Management<br/>Scoped keys<br/>Key rotation<br/>Audit logging"]
        CORS["🔀 CORS Policy<br/>Whitelist origins<br/>Credentials<br/>Preflight"]
    end

    %% Data Protection & Privacy
    subgraph DataProtection["Data Protection & Privacy"]
        GDPR["🏛️ GDPR Compliance<br/>Right to deletion<br/>Data portability<br/>Consent tracking"]
        DataMasking["👁️ Data Masking<br/>PII redaction<br/>Dev/test data<br/>Audit trails"]
        DataClassification["📂 Classification<br/>Public/Internal<br/>Confidential<br/>Restricted"]
    end

    %% Logging & Monitoring
    subgraph SecurityMonitoring["Security Monitoring & Audit"]
        AuditLog["📝 Audit Logs<br/>All access<br/>User ID<br/>Timestamp<br/>IP address"]
        SecurityLog["🔍 Security Logs<br/>Failed auth<br/>Policy violations<br/>Key access"]
        WAFLog["⚠️ WAF Logs<br/>Blocked requests<br/>Attack patterns"]
        SIEM["🔎 SIEM<br/>Splunk/ELK<br/>Correlation<br/>Alerting"]
    end

    %% Vulnerability Management
    subgraph VulnManagement["Vulnerability Management"]
        SAST["🔬 SAST<br/>SonarQube<br/>Code scanning<br/>CI/CD gate"]
        DAST["🧪 DAST<br/>OWASP ZAP<br/>Penetration<br/>API testing"]
        DependencyScan["📦 Dependency Scan<br/>Snyk/Trivy<br/>CVE database<br/>License check"]
        SecretScan["🔐 Secret Scan<br/>GitGuardian<br/>Leaked credentials<br/>Pre-commit hook"]
    end

    %% Incident Response
    subgraph IncidentResponse["Incident Response"]
        Alerting["🚨 Alerting<br/>PagerDuty<br/>Slack notifications<br/>Escalation"]
        ForensicsLogging["🔎 Forensics<br/>Event replay<br/>Timeline reconstruction<br/>Root cause"]
        DisasterRecovery["🔄 Disaster Recovery<br/>Backup encryption<br/>Recovery plan<br/>RTO: 1h"]
    end

    %% Compliance & Certification
    subgraph Compliance["Compliance & Certification"]
        ISO27001["✅ ISO 27001<br/>Information security<br/>Annual audit<br/>Certification"]
        SOC2["✅ SOC 2 Type II<br/>Controls attestation<br/>Quarterly reviews"]
        HIPAA["✅ HIPAA<br/>Healthcare data<br/>Encryption<br/>Access controls"]
        PCI_DSS["✅ PCI DSS<br/>Payment card data<br/>Network segmentation<br/>v3.2.1"]
    end

    %% Connections: User to Edge
    WebUser -->|HTTPS| CloudFlare
    MobileUser -->|HTTPS| CloudFlare
    ServiceAccount -->|HTTPS| CloudFlare

    %% Edge to Auth
    CloudFlare -->|Request| WAF
    WAF -->|Pass| AuthGateway

    %% Auth Methods
    AuthGateway -->|Web| OAuth2
    AuthGateway -->|Enterprise| SAML
    AuthGateway -->|2FA| MFA
    AuthGateway -->|Corporate| LDAP

    %% Token Management
    OAuth2 -->|Generate| JWTHandler
    SAML -->|Generate| SessionStore
    JWTHandler -->|Sign| AuthGateway
    SessionStore -->|Validate| AuthGateway

    %% Authorization
    AuthGateway -->|Check| PolicyEngine
    PolicyEngine -->|Query| RoleMatrix
    PolicyEngine -->|Query| ResourceACL
    PolicyEngine -->|Enforce| TenantIsolation

    %% Encryption - Transit
    AuthGateway -->|Secure| TLS
    AuthGateway -->|Service→Service| mTLS
    AuthGateway -->|Admin| VPN

    %% Encryption - At Rest
    TLS -->|Decrypt| DBTE
    mTLS -->|Decrypt| DiskEncryption
    DBTE -->|Encrypt PII| FieldEncryption

    %% Key Management
    DBTE -->|Key from| KMS
    FieldEncryption -->|Secret| SecretVault
    DiskEncryption -->|Rotate| KMS

    %% API Security
    WAF -->|Rate limit| RateLimiting
    RateLimiting -->|Validate| InputValidation
    AuthGateway -->|Scope| APIKey
    AuthGateway -->|Policy| CORS

    %% Data Protection
    FieldEncryption -->|Comply| GDPR
    FieldEncryption -->|Mask| DataMasking
    AuthGateway -->|Tag| DataClassification

    %% Logging & Monitoring
    AuthGateway -.->|Log access| AuditLog
    AuthGateway -.->|Log failures| SecurityLog
    WAF -.->|Log blocks| WAFLog
    AuditLog -.->|Aggregate| SIEM
    SecurityLog -.->|Aggregate| SIEM
    WAFLog -.->|Aggregate| SIEM

    %% Vulnerability Management
    SAST -.->|Scan| DependencyScan
    DAST -.->|Test| SecretScan
    DependencyScan -.->|Report| SIEM

    %% Incident Response
    SIEM -->|Alert| Alerting
    SIEM -->|Track| ForensicsLogging
    Alerting -->|Activate| DisasterRecovery

    %% Compliance
    AuditLog -.->|Evidence| ISO27001
    SecurityLog -.->|Evidence| SOC2
    GDPR -.->|Compliance| HIPAA
    PCI_DSS -.->|Standards| ISO27001

    %% Styling
    classDef user fill:#FF6B6B,stroke:#C92A2A,color:#fff,stroke-width:2px
    classDef edge fill:#E74C3C,stroke:#922B21,color:#fff,stroke-width:2px
    classDef auth fill:#3498DB,stroke:#1B4F72,color:#fff,stroke-width:2px
    classDef authz fill:#9B59B6,stroke:#6C3483,color:#fff,stroke-width:2px
    classDef encryption fill:#2ECC71,stroke:#186A3B,color:#fff,stroke-width:2px
    classDef api fill:#F39C12,stroke:#D68910,color:#fff,stroke-width:2px
    classDef data fill:#1ABC9C,stroke:#0B7285,color:#fff,stroke-width:2px
    classDef monitoring fill:#FFEAA7,stroke:#D68910,color:#333,stroke-width:2px
    classDef incident fill:#E67E22,stroke:#92400E,color:#fff,stroke-width:2px
    classDef compliance fill:#27AE60,stroke:#145A32,color:#fff,stroke-width:2px

    class WebUser,MobileUser,ServiceAccount user
    class CloudFlare,WAF edge
    class AuthGateway,OAuth2,SAML,MFA,LDAP,JWTHandler,SessionStore auth
    class PolicyEngine,RoleMatrix,ResourceACL,TenantIsolation authz
    class TLS,mTLS,VPN,DBTE,DiskEncryption,FieldEncryption,KMS,SecretVault encryption
    class RateLimiting,InputValidation,APIKey,CORS api
    class GDPR,DataMasking,DataClassification data
    class AuditLog,SecurityLog,WAFLog,SIEM monitoring
    class Alerting,ForensicsLogging,DisasterRecovery incident
    class ISO27001,SOC2,HIPAA,PCI_DSS compliance
